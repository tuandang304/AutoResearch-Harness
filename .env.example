# Optional shell environment; the harness does not auto-load .env.
# Use native CLI login stores; never copy session credentials here.
# AUTORESEARCH_LLM_CONFIG=/absolute/path/to/configs/llm.yaml
# AUTORESEARCH_ROUTER_STATE=/absolute/path/to/.state/llm-router.sqlite
# Optional API adapters (not needed for authenticated CLI profiles):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
